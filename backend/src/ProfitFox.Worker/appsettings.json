{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Backtests": {
    "MaxParallelism": null,
    "DefaultFees": {
      "spot": { "Limit": 0.1, "Market": 0.1, "Slippage": 0.1 },
      "linear": { "Limit": 0.02, "Market": 0.055, "Slippage": 0.05 }
    }
  },
  "Worker": {
    "PollInterval": "00:00:01",
    "LeaseDuration": "00:00:30",
    "LeaseRenewal": "00:00:10",
    "ChunkSize": 100
  },
  "Trading": {
    "Enabled": false,
    "LeaseDuration": "00:05:00",
    "LeaseRenewal": "00:01:00"
  },
  "TInvest": {
    "Endpoint": "https://invest-public-api.tbank.ru:443",
    "AppName": "profit-fox",
    "RequestTimeout": "00:00:10",
    "Limits": {
      "Users": 50,
      "Instruments": 150,
      "MarketData": 150,
      "Operations": 100,
      "Orders": 50
    },
    "Certificates": {
      "Directory": "Exchanges/TInvest/Certificates",
      "RootThumbprint": "",
      "SubThumbprint": ""
    }
  }
}
