<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ProfitFox.Application\ProfitFox.Application.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.89"/>
        <PackageReference Include="FluentMigrator.Runner.Postgres" Version="8.0.1"/>
        <PackageReference Include="Google.Protobuf" Version="3.36.2"/>
        <PackageReference Include="Grpc.Net.Client" Version="2.85.0"/>
        <PackageReference Include="Grpc.Tools" Version="2.85.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Npgsql" Version="10.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="MarketData\Protos\*.proto" GrpcServices="Both" ProtoRoot="MarketData\Protos"/>
    </ItemGroup>

</Project>
