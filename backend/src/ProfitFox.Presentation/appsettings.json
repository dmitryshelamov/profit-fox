{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "FluentMigrator": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Ideas": {
    "Thresholds": {
      "Candles": 6,
      "Move": 3.0,
      "Volume": 2.0,
      "EarlyMove": 1.5,
      "EarlyVolume": 3.0,
      "BreakoutMargin": 0.1,
      "BreakoutVolume": 1.5,
      "SweepMargin": 0.2,
      "SqueezeCandles": 20,
      "ClimaxVolume": 4.0,
      "Wick": 1.0,
      "QuietVolume": 3.0,
      "QuietBody": 0.3,
      "BiasRatio": 1.5,
      "FlatMove": 0.5,
      "Overbought": 70,
      "Oversold": 30
    },
    "ByInterval": {},
    "StopBuffer": 1.5,
    "ZoneMerge": 0.5,
    "ZoneStrength": 2
  },
  "Backtests": {
    "MaxCombinations": 10000,
    "MaxParallelism": null,
    "DefaultFees": {
      "spot": {
        "Limit": 0.1,
        "Market": 0.1,
        "Slippage": 0.1
      },
      "linear": {
        "Limit": 0.02,
        "Market": 0.055,
        "Slippage": 0.05
      },
      "moex": {
        "Limit": 0.05,
        "Market": 0.05,
        "Slippage": 0.1
      }
    }
  },
  "AllowedHosts": "*",
  "TInvest": {
    "Endpoint": "https://invest-public-api.tbank.ru:443",
    "AppName": "profit-fox",
    "RequestTimeout": "00:00:10",
    "Limits": {
      "Users": 50,
      "Instruments": 150,
      "MarketData": 100,
      "Operations": 100,
      "Orders": 50
    },
    "Certificates": {
      "Directory": "Exchanges/TInvest/Certificates",
      "RootThumbprint": "",
      "SubThumbprint": ""
    }
  }
}
