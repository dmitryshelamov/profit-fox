<Project>

    <!--
        The boundaries of the zones (docs/adr/0001-one-repository-with-zones.md): a project lists the projects it may reference
        directly, and the build fails on any other. Engine references nothing outside itself; Bot and Bench reference Engine and
        never each other. The test projects have no list yet.
    -->
    <PropertyGroup>
        <_EngineProjects>ProfitFox.Engine.Strategy;ProfitFox.Engine.Simulation</_EngineProjects>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.Engine.Strategy'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences></AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.Engine.Simulation'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.Engine.Strategy</AllowedLayerReferences>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.Bot.Domain'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.Engine.Strategy</AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.Bot.Application'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.Bot.Domain;$(_EngineProjects)</AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.Bot.Infrastructure'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.Bot.Application;ProfitFox.Bot.Domain;$(_EngineProjects)</AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.Bot.Api' Or '$(MSBuildProjectName)' == 'ProfitFox.Bot.Worker'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.Bot.Infrastructure;ProfitFox.Bot.Application;ProfitFox.Bot.Domain;$(_EngineProjects)</AllowedLayerReferences>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.Bench'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>$(_EngineProjects)</AllowedLayerReferences>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProfitFox.Bench.Cli'">
        <CheckLayerReferences>true</CheckLayerReferences>
        <AllowedLayerReferences>ProfitFox.Bench;$(_EngineProjects)</AllowedLayerReferences>
    </PropertyGroup>

    <Target Name="CheckLayerReferences" BeforeTargets="ResolveProjectReferences" Condition="'$(CheckLayerReferences)' == 'true'">
        <ItemGroup>
            <_LayerReference Include="@(ProjectReference->'%(Filename)')"/>
            <_ForbiddenLayerReference Include="@(_LayerReference)" Exclude="$(AllowedLayerReferences)"/>
        </ItemGroup>
        <Error Condition="'@(_ForbiddenLayerReference)' != ''"
               Text="$(MSBuildProjectName) may reference only [$(AllowedLayerReferences)], not @(_ForbiddenLayerReference). The allowed references are listed in backend/Directory.Build.targets."/>
    </Target>

</Project>
