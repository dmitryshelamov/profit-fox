{
  "name": "new-high",
  "description": "Новый максимум: close выше максимума high за extremeCandles свечей до текущей.",
  "graph": {
    "formatVersion": 1,
    "parameters": [
      {
        "name": "extremeCandles",
        "type": "number",
        "value": 200
      }
    ],
    "outputs": [
      {
        "name": "state",
        "type": "boolean"
      }
    ],
    "nodes": [
      {
        "id": "p",
        "kind": "parameters"
      },
      {
        "id": "c",
        "kind": "candle"
      },
      {
        "id": "range",
        "kind": "window",
        "settings": {
          "operation": "max"
        }
      },
      {
        "id": "range-prev",
        "kind": "previous"
      },
      {
        "id": "state",
        "kind": "compare",
        "settings": {
          "operation": "gt"
        }
      },
      {
        "id": "out",
        "kind": "outputs"
      }
    ],
    "wires": [
      {
        "from": "c.high",
        "to": "range.value"
      },
      {
        "from": "p.extremeCandles",
        "to": "range.length"
      },
      {
        "from": "range.result",
        "to": "range-prev.value"
      },
      {
        "from": "c.close",
        "to": "state.a"
      },
      {
        "from": "range-prev.result",
        "to": "state.b"
      },
      {
        "from": "state.result",
        "to": "out.state"
      }
    ]
  },
  "layout": {}
}
