{
  "id": "H0002",
  "name": "funding-short-2d",
  "statement": "Эталон наложения событий: шорт на 2 дня от события H0001. События приходят раз в сутки, поэтому каждое второе застаёт позицию открытой.",
  "created": "2026-11-18",
  "timeframe": "4h",
  "block": "week",
  "randomsPerEvent": 20,
  "measure": "net",
  "minEffect": 0.003,
  "signal": {
    "formatVersion": 1,
    "parameters": [{ "name": "threshold", "type": "number", "value": 0.0005 }],
    "outputs": [{ "name": "entry", "type": "event" }],
    "nodes": [
      { "id": "p", "kind": "parameters" },
      { "id": "rate", "kind": "funding-rate" },
      { "id": "high", "kind": "compare", "settings": { "operation": "ge" } },
      { "id": "first", "kind": "first-time" },
      { "id": "out", "kind": "outputs" }
    ],
    "wires": [
      { "from": "rate.value", "to": "high.a" },
      { "from": "p.threshold", "to": "high.b" },
      { "from": "high.result", "to": "first.value" },
      { "from": "first.event", "to": "out.entry" }
    ]
  },
  "plan": { "side": "short", "horizon": "2d" }
}
