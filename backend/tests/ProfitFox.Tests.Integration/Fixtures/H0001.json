{
  "id": "H0001",
  "name": "funding-short-4h",
  "statement": "Когда последняя выплата фандинга пары впервые достигает 0,05 % или больше, шорт на 4 часа от закрытия четырёхчасовой свечи зарабатывает после издержек больше, чем шорт той же пары в случайный момент той же недели.",
  "created": "2026-11-18",
  "timeframe": "4h",
  "block": "week",
  "randomsPerEvent": 20,
  "measure": "net",
  "minEffect": 0.003,
  "signal": {
    "formatVersion": 1,
    "parameters": [{ "name": "threshold", "type": "number", "value": 0.0005 }],
    "outputs": [{ "name": "entry", "type": "event" }],
    "nodes": [
      { "id": "p", "kind": "parameters" },
      { "id": "rate", "kind": "funding-rate" },
      { "id": "high", "kind": "compare", "settings": { "operation": "ge" } },
      { "id": "first", "kind": "first-time" },
      { "id": "out", "kind": "outputs" }
    ],
    "wires": [
      { "from": "rate.value", "to": "high.a" },
      { "from": "p.threshold", "to": "high.b" },
      { "from": "high.result", "to": "first.value" },
      { "from": "first.event", "to": "out.entry" }
    ]
  },
  "plan": { "side": "short", "horizon": "4h" }
}
