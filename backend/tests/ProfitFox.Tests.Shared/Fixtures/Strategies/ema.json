    },
    {
      "from": "flat.result",
      "to": "entry.b"
    },
    {
      "from": "entry.result",
      "to": "enter.when"
    },
    {
      "from": "params.amount",
      "to": "enter.size"
    },
    {
      "from": "cross.down",
      "to": "exit.when"
    }
  ],
  "layout": {
    "params": {
      "x": 0,
      "y": 0
    },
    "cross": {
      "x": 240,
      "y": 0
    },
    "enter": {
      "x": 480,
      "y": 0
