{
  "formatVersion": 1,
  "direction": "long",
  "parameters": [
    {
      "name": "limitPerOrder",
      "type": "number",
      "default": 100,
      "min": 0
    },
    {
      "name": "limitDeposit",
      "type": "number",
      "default": 250,
      "min": 0
    },
    {
      "name": "purchaseInterval",
      "type": "duration",
      "default": "01:00:00"
    }
  ],
  "nodes": [
    {
      "id": "params",
      "kind": "parameters"
    },
    {
      "id": "position",
      "kind": "position"
    },
    {
      "id": "flat",
      "kind": "not"
    },
    {
      "id": "due",
      "kind": "compare",
      "settings": {
        "type": "duration",
        "operation": "ge"
      }
    },
    {
      "id": "time",
      "kind": "or"
    },
    {
      "id": "nextInvested",
      "kind": "add"
    },
    {
      "id": "budget",
      "kind": "compare",
      "settings": {
        "operation": "le"
      }
    },
    {
      "id": "go",
      "kind": "and"
    },
    {
      "id": "buy",
      "kind": "market-order",
      "settings": {
        "side": "buy",
        "size": "amount"
      }
    }
  ],
  "wires": [
    {
      "from": "position.hasPosition",
      "to": "flat.value"
    },
    {
      "from": "position.sinceLastEntry",
      "to": "due.a"
    },
    {
      "from": "params.purchaseInterval",
      "to": "due.b"
    },
    {
      "from": "flat.result",
      "to": "time.a"
    },
    {
      "from": "due.result",
      "to": "time.b"
    },
    {
      "from": "position.invested",
      "to": "nextInvested.a"
    },
    {
      "from": "params.limitPerOrder",
      "to": "nextInvested.b"
    },
    {
      "from": "nextInvested.result",
      "to": "budget.a"
    },
    {
      "from": "params.limitDeposit",
      "to": "budget.b"
    },
    {
      "from": "time.result",
      "to": "go.a"
    },
    {
      "from": "budget.result",
      "to": "go.b"
    },
    {
      "from": "go.result",
      "to": "buy.when"
    },
    {
      "from": "params.limitPerOrder",
      "to": "buy.size"
    }
  ],
  "layout": {}
}
