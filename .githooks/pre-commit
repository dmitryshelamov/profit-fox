#!/bin/sh
# Fast checks before a commit: build (with analyzers) and format. Tests run in CI.
# Enable once per clone: git config core.hooksPath .githooks
set -e

staged=$(git diff --cached --name-only)

# The .NET build reads backend/ and .editorconfig.
if echo "$staged" | grep -qE '^(backend/|\.editorconfig$)'; then
    dotnet build backend/ProfitFox.sln --nologo -v:q
    dotnet format backend/ProfitFox.sln --verify-no-changes --no-restore
fi

if echo "$staged" | grep -qE '^frontend/'; then
    npm --prefix frontend run --silent lint
    npm --prefix frontend run --silent format:check
    npm --prefix frontend run --silent typecheck
fi
